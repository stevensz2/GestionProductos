<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
    <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/stock_control?useSSL=false&amp;serverTimezone=UTC</property>
    <property name="hibernate.connection.username">root</property>
    <property name="hibernate.connection.password">vivacristoreY12345.</property>
    <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
    <!-- "update" crea la tabla si no existe y la ajusta si faltan columnas;
         evita que la aplicación falle al iniciar cuando la BD está vacía.
         Si ya tienes la tabla creada manualmente y quieres máxima seguridad,
         puedes cambiarlo de nuevo a "validate". -->
    <property name="hibernate.hbm2ddl.auto">update</property>
    <property name="show_sql">true</property>
    <mapping class="com.gestionproductos.model.Producto"/>
  </session-factory>
</hibernate-configuration>